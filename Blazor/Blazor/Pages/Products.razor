@page "/products"

@using Blazor.Data
@inject CartService CartService

<PageTitle>Products</PageTitle>

<h1>All products</h1>

<ul class="product-list">
    @foreach (var p in ProductStore.Products)
    {
        @* Trzeba dodać wyszukiwarkę produktów *@
        <li>
            <div style="display:flex;align-items:center;justify-content:space-between;width:100%;">
                <div>
                    <h3>@p.Name</h3>
                    <p>@p.ShortDescription</p>
                </div>
                <div style="display:flex;gap:0.5rem;align-items:center;">
                    <NavLink class="btn" href="@($"/product/{p.Id}")">See more</NavLink>
                    <button class="btn" @onclick="() => AddToCart(p)">Add to cart</button>
                </div>
            </div>
        </li>
    }
</ul>

@code {
   private void AddToCart(Product p) => CartService.Add(p);
}
