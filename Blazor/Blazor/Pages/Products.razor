@page "/products"

@using Blazor.Data
@using Blazor.Services
@inject CartService CartService
@inject ProductService ProductService

<PageTitle>Products</PageTitle>

<div class="products-header">
    <h1>All products</h1>
    
    <div class="search-container">
        <input type="text" 
               class="search-input" 
               placeholder="Search products by name, description, or SKU..." 
               @bind="searchTerm" 
               @bind:event="oninput"
               @onkeyup="OnSearchChanged" />
        @if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            <button class="clear-search-btn" @onclick="ClearSearch" title="Clear search">✕</button>
        }
    </div>
</div>

@if (products == null)
{
    <p><em>Loading...</em></p>
}
else if (products.Count == 0)
{
    @if (string.IsNullOrWhiteSpace(searchTerm))
    {
        <p>No products available.</p>
    }
    else
    {
        <p>No products found matching "<strong>@searchTerm</strong>".</p>
        <button class="btn" @onclick="ClearSearch">Clear search</button>
    }
}
else
{
    <ul class="product-list">
        @foreach (var p in products)
        {
            <li>
                <div style="display:flex;align-items:center;justify-content:space-between;width:100%;">
                    <div>
                        <h3>@p.Name</h3>
                        <p>@p.Description</p>
                    </div>
                    <div style="display:flex;gap:0.5rem;align-items:center;">
                        <NavLink class="btn" href="@($"/product/{p.ProductId}")">See more</NavLink>
                        <button class="btn" @onclick="() => AddToCart(p)">Add to cart</button>
                    </div>
                </div>
            </li>
        }
    </ul>
}

@code {
    private List<Product>? products;
    private string searchTerm = "";
    private System.Threading.Timer? debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        products = await ProductService.GetProductsAsync(string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm);
    }

    private void OnSearchChanged()
    {
        // Debounce search to avoid excessive API calls
        debounceTimer?.Dispose();
        debounceTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadProducts();
                StateHasChanged();
            });
        }, null, 300, Timeout.Infinite);
    }

    private async Task ClearSearch()
    {
        searchTerm = "";
        await LoadProducts();
    }

    private void AddToCart(Product p) => CartService.Add(p);

    public void Dispose()
    {
        debounceTimer?.Dispose();
    }
}
